# Application
APP_NAME="Quiz Game API"
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Generate a production key with: openssl rand -hex 32
SECRET_KEY=development-only-change-this-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30


# Local PostgreSQL (matches compose.yaml)
DATABASE_URL=postgresql+asyncpg://quiz:quiz@localhost:5432/quiz

# JSON arrays are required by pydantic-settings.
CORS_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","10.0.2.2","testserver","192.168.1.8"]
GOOGLE_WEB_CLIENT_ID=664465470290-b50a1e1cbkt0hm297mggnk3kno09hlvi.apps.googleusercontent.com

# Password reset. The Android app registers the quizgame:// scheme, so the emailed
# link opens the reset screen directly on the phone.
PASSWORD_RESET_URL=quizgame://reset-password

# Optional: seed one admin user on startup (skipped if this email already
# exists). Leave both empty to skip seeding entirely.
FIRST_ADMIN_EMAIL=admin@quizgame.dev
FIRST_ADMIN_PASSWORD=admin123
FIRST_ADMIN_USERNAME=admin

# Development SMTP -- Mailpit ships in compose.yaml; read the mail at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@quizgame.dev
SMTP_USE_SSL=false
SMTP_START_TLS=false
SMTP_TIMEOUT_SECONDS=10

# Real provider on port 587 (e.g. Gmail SMTP with an App Password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@example.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=you@example.com
# SMTP_USE_SSL=false
# SMTP_START_TLS=true

# Real provider on SSL port 465:
# SMTP_PORT=465
# SMTP_USE_SSL=true
# SMTP_START_TLS=false

# Avatar storage -- a folder in the maintainer's own Google Drive.
# Obtain the three values below by running, once, on a machine with a browser:
#   conda run -n backend python -m scripts.google_drive_authorize path/to/client_secret.json
# Leave them empty in development and avatars fall back to in-memory storage (lost on
# restart); ENVIRONMENT=staging/production refuses to start without them.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_AVATAR_FOLDER_ID=1FGB_U6l16Y-hNmMVTHBbfdgQkS5MeGiA
MAX_AVATAR_BYTES=2097152

# Application
APP_NAME="Quiz Game API"
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Generate a production key with: openssl rand -hex 32
SECRET_KEY=development-only-change-this-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30


# Local PostgreSQL (matches compose.yaml)
DATABASE_URL=postgresql+asyncpg://quiz:quiz@localhost:5432/quiz

# JSON arrays are required by pydantic-settings.
CORS_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","10.0.2.2","testserver","192.168.1.8"]
GOOGLE_WEB_CLIENT_ID=664465470290-b50a1e1cbkt0hm297mggnk3kno09hlvi.apps.googleusercontent.com